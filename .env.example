# ── IA (Anthropic) ─────────────────────────────────────────────
# Obtén tu clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Perfil económico por defecto (≈ 0,50 $/mes): Haiku en todo y razonamiento mínimo.
# Más calidad: LLM_MODEL=claude-sonnet-5-5 o claude-opus-5-5 (o elige un perfil en Ajustes)
LLM_MODEL=claude-haiku-5-5
LLM_FAST_MODEL=claude-haiku-5-5
# Profundidad de razonamiento: low | medium | high | xhigh | max
LLM_EFFORT=low

# ── Backend ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/jobtracker.db
UPLOAD_DIR=./data/uploads
# Peso del score de la IA frente a la cobertura de skills calculada (0-1)
MATCH_LLM_WEIGHT=0.7

# ── Gmail (opcional) ──────────────────────────────────────────
# simulated = lee data/samples/sample_emails.json | gmail = API real de Gmail
EMAIL_MODE=simulated
GMAIL_CREDENTIALS_FILE=./data/gmail_credentials.json
GMAIL_TOKEN_FILE=./data/gmail_token.json
# Consulta Gmail para filtrar correos relevantes
GMAIL_QUERY=newer_than:14d (entrevista OR interview OR candidatura OR application OR proceso)
